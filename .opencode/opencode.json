{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "disabled_providers": [],
  "enabled_providers": [
    "github-copilot",
    "openrouter"
  ],
  "provider": {
    "github-copilot": {
      "whitelist": [
        "claude-haiku-4-5",
        "gemini-2.5-pro",
        "gemini-3.1-pro-preview",
        "gemini-3-flash-preview"
      ]
    },
    "openrouter": {
      "name": "OPENROUTER3",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      }
    }
  }
}